   "source": [
    "n1 = len(female_dci)\n",
    "n2 = len(male_dci)\n",
    "\n",
    "s1 = np.var(female_dci, ddof=1)\n",
    "s2 = np.var(male_dci, ddof=1)\n",
    "\n",
    "pooled_sd = np.sqrt(\n",
    "    ((n1 - 1)*s1 + (n2 - 1)*s2) /\n",
    "    (n1 + n2 - 2)\n",
    ")\n",
    "\n",
    "d = (\n",
    "    female_dci.mean() - male_dci.mean()\n",
    ") / pooled_sd\n",
    "\n",
    "print(\"Cohen's d =\", d)"
   ]
