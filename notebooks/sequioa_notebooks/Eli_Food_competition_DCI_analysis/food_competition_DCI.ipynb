   "source": [
    "# ============================================================\n",
    "# Calculate hierarchy metrics for all cages\n",
    "# ============================================================\n",
    "\n",
    "results = []\n",
    "\n",
    "for sex, info in datasets.items():\n",
    "\n",
    "    d1 = pd.read_excel(file, sheet_name=info[\"d1_sheet\"])\n",
    "    d2 = pd.read_excel(file, sheet_name=info[\"d2_sheet\"])\n",
    "\n",
    "    for cage_num, (wcol, lcol) in info[\"cols\"].items():\n",
    "\n",
    "        cage_d1 = get_cage_data(\n",
    "            d1,\n",
    "            wcol,\n",
    "            lcol,\n",
    "            start_row=1\n",
    "        )\n",
    "\n",
    "        cage_d2 = get_cage_data(\n",
    "            d2,\n",
    "            wcol,\n",
    "            lcol,\n",
    "            start_row=info[\"d2_start_row\"]\n",
    "        )\n",
    "\n",
    "        combined = pd.concat(\n",
    "            [cage_d1, cage_d2],\n",
    "            ignore_index=True\n",
    "        )\n",
    "\n",
    "        # Remove impossible self-interactions\n",
    "        combined = combined[\n",
    "            combined[\"winner\"] != combined[\"loser\"]\n",
    "        ]\n",
    "\n",
    "        hier = Hierarchia(\n",
    "            combined,\n",
    "            \"winner\",\n",
    "            \"loser\"\n",
    "        )\n",
    "\n",
    "        results.append({\n",
    "            \"cage\": cage_num,\n",
    "            \"sex\": sex,\n",
    "            \"DCI\": hier.dci(),\n",
    "            \"Landau_h\": hier.landau_h()[\"Improved_Landau_h\"]\n",
    "        })\n",
    "\n",
    "results = pd.DataFrame(results)\n",
    "\n",
    "results"
   ]
  },
