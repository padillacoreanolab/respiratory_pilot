    "# Iterate through the entire recording in 10-second chunks\n",
    "total_samples = traces_car.shape[0]\n",
    "step = samples_per_10sec\n",
    "\n",
    "for start_idx in range(0, total_samples, step):\n",
    "    end_idx = start_idx + samples_per_10sec\n",
    "    if end_idx > total_samples:  # Handle the last chunk\n",
    "        end_idx = total_samples\n",
    "\n",
    "    ten_sec_trace = traces_car[start_idx:end_idx, channel] * scaling_factor\n",
    "\n",
    "    # Plot the 10-second trace and subplots (reuse the existing plotting code)\n",
    "    fig = plt.figure(figsize=(10, 20))\n",
    "    gs = fig.add_gridspec(11, 1, height_ratios=[2] + [1] * 10)\n",
    "\n",
    "    # Full 10-second trace\n",
    "    ax1 = fig.add_subplot(gs[0, 0])\n",
    "    ax1.plot(ten_sec_trace, color='b')\n",
    "    ax1.set_title(f\"10-Second Trace (Channel {channel}, Samples {start_idx}–{end_idx})\", fontsize=16)\n",
    "    ax1.set_ylabel(\"Amplitude (µV)\")\n",
    "    ax1.grid()\n",
    "\n",
    "    # 1-second subplots\n",
    "    for i in range(10):\n",
    "        chunk_start = i * samples_per_1sec\n",
    "        chunk_end = chunk_start + samples_per_1sec\n",
    "        if chunk_end > len(ten_sec_trace):  # Prevent overflow in the last chunk\n",
    "            break\n",
    "\n",
    "        ax = fig.add_subplot(gs[i + 1, 0])\n",
    "        ax.plot(ten_sec_trace[chunk_start:chunk_end], color='b')\n",
    "        ax.set_title(f\"Second {i + 1}\")\n",
    "        ax.set_ylabel(\"Amplitude (µV)\")\n",
    "        ax.grid()\n",
    "\n",
    "    fig.text(0.5, 0.04, \"Samples\", ha='center', fontsize=12)\n",
    "    plt.tight_layout(rect=[0, 0.05, 1, 0.98])\n",
    "    plt.show()\n"
   ]
